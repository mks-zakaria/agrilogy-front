# .env (inside ./front)

# Next.js server config
HOST=0.0.0.0
PORT=3000

# Public API URL for frontend requests (browser will use this)
NEXT_PUBLIC_API_URL=http://157.245.43.196:8000

# Optional - used only during build (Node server-side fetches)
API_URL=http://157.245.43.196:8000

# Chat assistant (Anthropic) — required for Agrilogy chatbot in the browser.
# Warning: NEXT_PUBLIC_* is visible to clients; prefer a server Route Handler + secret key for production.
# NEXT_PUBLIC_ANTHROPIC_API_KEY=

# "Report an issue" screen-recording upload (Cloudinary, unsigned preset).
# Optional: if unset, the report form hides the "Record screen" option and
# submits text-only. Create an unsigned upload preset in your Cloudinary
# dashboard, then set both:
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# App version + environment tag shown on submitted reports (optional).
# NEXT_PUBLIC_APP_VERSION=0.1.0
# NEXT_PUBLIC_ENV=production

# Disable Next telemetry (optional)
NEXT_TELEMETRY_DISABLED=1

# Example other env vars
NODE_ENV=production
